+// explorer7: glass address row ---------------------------------------------
+QRect DolphinMainWindow::e7GlassRect() const
+{
+    const KToolBar *tb = findChild<KToolBar *>(QStringLiteral("mainToolBar"));
+    if (!tb || !tb->isVisible() || toolBarArea(const_cast<KToolBar *>(tb)) != Qt::TopToolBarArea) {
+        return {};
+    }
+    return QRect(0, 0, width(), tb->geometry().bottom() + 1);
+}
+
+void DolphinMainWindow::e7UpdateGlass()
+{
+    if (QWindow *w = windowHandle()) {
+        const QRect glass = e7GlassRect();
+        KWindowEffects::enableBlurBehind(w, !glass.isEmpty(), QRegion(glass));
+    }
+    update();
+}
+
+void DolphinMainWindow::paintEvent(QPaintEvent *event)
+{
+    QPainter p(this);
+    p.setCompositionMode(QPainter::CompositionMode_Source);
+    p.fillRect(rect(), Qt::white); // explorer's body is white between the panes
+    const QRect glass = e7GlassRect();
+    if (!glass.isEmpty()) {
+        p.fillRect(glass, Qt::transparent);
+    }
+    p.end();
+    KXmlGuiWindow::paintEvent(event);
+}
+
+// explorer7: windows 7 shows its menu bar under the address row, a qt menu bar always sits above the toolbars;
+// so a toolbar row holds a second menu bar sharing dolphin's menus and the real one stays hidden
+void DolphinMainWindow::e7SetupMenuBar()
+{
+    QMenuBar *real = menuBar();
+    auto *row = new QToolBar(i18nc("@title:window", "Menu Bar"), this);
+    row->setObjectName(QStringLiteral("e7MenuBar"));
+    row->setMovable(false);
+    row->setFloatable(false);
+    row->toggleViewAction()->setVisible(false);
+    auto *bar = new QMenuBar(row);
+    bar->setNativeMenuBar(false);
+    const auto tops = real->actions();
+    for (QAction *a : tops) {
+        const QString name = a->menu() ? a->menu()->objectName() : QString();
+        if (name == QLatin1String("go") || name == QLatin1String("settings")) continue; // explorer: File Edit View Tools Help
+        bar->addAction(a);
+    }
+    row->addWidget(bar);
+    if (KToolBar *cmd = findChild<KToolBar *>(QStringLiteral("commandBar"))) {
+        insertToolBar(cmd, row);
+        insertToolBarBreak(cmd);
+        insertToolBarBreak(row);
+    } else {
+        addToolBarBreak();
+        addToolBar(row);
+    }
+    real->hide();
+    real->installEventFilter(this);
+    m_e7MenuRow = row;
+    if (QAction *show = actionCollection()->action(QStringLiteral("e7_menubar"))) {
+        show->setChecked(KSharedConfig::openConfig()->group(QStringLiteral("Explorer7")).readEntry("MenuBar", true));
+        row->setVisible(show->isChecked());
+        connect(show, &QAction::toggled, this, [row](bool on) {
+            row->setVisible(on);
+            KConfigGroup g = KSharedConfig::openConfig()->group(QStringLiteral("Explorer7"));
+            g.writeEntry("MenuBar", on);
+            g.sync();
+        });
+    }
+}
+
+bool DolphinMainWindow::eventFilter(QObject *watched, QEvent *event)
+{
+    // explorer7: the menus live in the row under the address bar; dolphin's own menu bar stays hidden
+    if (watched == menuBar() && event->type() == QEvent::Show) {
+        QTimer::singleShot(0, menuBar(), &QWidget::hide);
+    }
+    return KXmlGuiWindow::eventFilter(watched, event);
+}
