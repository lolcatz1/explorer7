diff --git a/src/explorer7/e7navpane.cpp b/src/explorer7/e7navpane.cpp
new file mode 100644
index 0000000..3c7bc99
--- /dev/null
+++ b/src/explorer7/e7navpane.cpp
@@ -0,0 +1,217 @@
+#include "e7navpane.h"
+#include "e7assets.h"
+#include "dolphinplacesmodelsingleton.h"
+
+#include <KFilePlacesModel>
+#include <KLocalizedString>
+#include <QApplication>
+#include <QDir>
+#include <QHeaderView>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QStandardPaths>
+#include <QSet>
+#include <QStyledItemDelegate>
+
+namespace
+{
+constexpr int RowHeight = 21;
+constexpr int UrlRole = Qt::UserRole + 1;
+constexpr int SpacerRole = Qt::UserRole + 2;
+// geometry measured on windows 7 explorer (96 dpi): x of glyph, icon, text per depth
+int glyphX(int depth) { return depth == 0 ? 0 : 12 * depth; }
+int iconX(int depth) { return 16 + 12 * depth; }
+int textX(int depth) { return iconX(depth) + (depth == 0 ? 22 : 19); }
+int depthOf(const QModelIndex &i) { int d = 0; for (QModelIndex p = i.parent(); p.isValid(); p = p.parent()) ++d; return d; }
+}
+
+class E7NavDelegate : public QStyledItemDelegate
+{
+public:
+    explicit E7NavDelegate(E7NavPane *pane) : QStyledItemDelegate(pane), m_pane(pane) {}
+
+    QSize sizeHint(const QStyleOptionViewItem &, const QModelIndex &) const override { return {100, RowHeight}; }
+
+    void paint(QPainter *p, const QStyleOptionViewItem &opt, const QModelIndex &index) const override
+    {
+        if (index.data(SpacerRole).toBool()) {
+            return;
+        }
+        p->save();
+        const int d = depthOf(index);
+        const QRect r = opt.rect;
+        const bool hot = opt.state & QStyle::State_MouseOver, sel = opt.state & QStyle::State_Selected;
+        const bool focus = m_pane->hasFocus();
+        // highlight starts just left of the icon and runs to the pane's edge (Explorer::TreeView TREEITEM, 3px margins)
+        const QRect hl(r.left() + iconX(d) - 3, r.top(), r.right() - (r.left() + iconX(d) - 3) - 1, r.height());
+        QString img;
+        if (sel && hot) img = QStringLiteral("tree-hotselected");
+        else if (sel) img = focus ? QStringLiteral("tree-selected") : QStringLiteral("tree-selectednotfocus");
+        else if (hot) img = QStringLiteral("tree-hot");
+        if (!img.isEmpty()) E7::drawFrame(p, hl, img, 3, 3, 3, 3);
+        // expand glyph: only while the mouse is over the pane, like explorer
+        QTreeWidgetItem *item = m_pane->itemFromIndex(index);
+        if (item && item->childCount() > 0 && m_pane->underMouse()) {
+            const bool open = item->isExpanded();
+            const QString g = QStringLiteral("%1-%2").arg(hot ? QStringLiteral("tree-hotglyph") : QStringLiteral("tree-glyph")).arg(open ? 2 : 1);
+            const QPixmap gp = E7::pixmap(g);
+            p->drawPixmap(r.left() + glyphX(d), r.top() + (r.height() - 16) / 2, 16, 16, gp);
+        }
+        const QIcon ic = index.data(Qt::DecorationRole).value<QIcon>();
+        ic.paint(p, QRect(r.left() + iconX(d), r.top() + (r.height() - 16) / 2, 16, 16));
+        p->setPen(QColor(0, 0, 0));
+        p->setFont(opt.font);
+        p->drawText(QRect(r.left() + textX(d), r.top(), r.width() - textX(d) - 4, r.height()), Qt::AlignVCenter | Qt::AlignLeft, opt.fontMetrics.elidedText(index.data().toString(), Qt::ElideRight, r.width() - textX(d) - 6));
+        p->restore();
+    }
+
+private:
+    E7NavPane *m_pane;
+};
+
+E7NavPane::E7NavPane(QWidget *parent)
+    : QTreeWidget(parent)
+    , m_closed{i18n("Computer")} // explorer's defaults: favorites and libraries open, computer closed
+{
+    setObjectName(QStringLiteral("e7NavPane"));
+    setHeaderHidden(true);
+    setIndentation(0);
+    setRootIsDecorated(false);
+    setFrameShape(QFrame::NoFrame);
+    setMouseTracking(true);
+    setUniformRowHeights(false);
+    setItemDelegate(new E7NavDelegate(this));
+    setFocusPolicy(Qt::StrongFocus);
+    setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    setAttribute(Qt::WA_Hover);
+    QPalette pal = palette();
+    pal.setColor(QPalette::Base, Qt::white);
+    pal.setColor(QPalette::Window, Qt::white);
+    setPalette(pal);
+    rebuild();
+    connect(this, &QTreeWidget::itemClicked, this, [this](QTreeWidgetItem *item) {
+        const QUrl u = item->data(0, UrlRole).toUrl();
+        if (u.isValid()) Q_EMIT placeActivated(u);
+    });
+    connect(this, &QTreeWidget::itemActivated, this, [this](QTreeWidgetItem *item) {
+        const QUrl u = item->data(0, UrlRole).toUrl();
+        if (u.isValid()) Q_EMIT placeActivated(u);
+    });
+    connect(this, &QTreeWidget::itemCollapsed, this, [this](QTreeWidgetItem *t) { m_closed.insert(t->text(0)); });
+    connect(this, &QTreeWidget::itemExpanded, this, [this](QTreeWidgetItem *t) { m_closed.remove(t->text(0)); });
+    auto *model = DolphinPlacesModelSingleton::instance().placesModel();
+    connect(model, &QAbstractItemModel::rowsInserted, this, &E7NavPane::rebuild);
+    connect(model, &QAbstractItemModel::rowsRemoved, this, &E7NavPane::rebuild);
+}
+
+QTreeWidgetItem *E7NavPane::addItem(QTreeWidgetItem *parent, const QString &text, const QString &icon, const QUrl &url, const QIcon &fallback)
+{
+    auto *it = parent ? new QTreeWidgetItem(parent) : new QTreeWidgetItem(this);
+    it->setText(0, text);
+    QIcon ic = E7::icon(icon);
+    it->setIcon(0, ic.isNull() ? fallback : ic);
+    it->setData(0, UrlRole, url);
+    return it;
+}
+
+void E7NavPane::addSpacer()
+{
+    auto *it = new QTreeWidgetItem(this);
+    it->setData(0, SpacerRole, true);
+    it->setFlags(Qt::NoItemFlags);
+}
+
+void E7NavPane::rebuild()
+{
+    const QUrl current = currentItem() ? currentItem()->data(0, UrlRole).toUrl() : QUrl();
+    clear();
+    auto loc = [](QStandardPaths::StandardLocation l) { return QUrl::fromLocalFile(QStandardPaths::writableLocation(l)); };
+    const QUrl home = QUrl::fromLocalFile(QDir::homePath());
+
+    auto *fav = addItem(nullptr, i18n("Favorites"), QStringLiteral("favorites"), home);
+    addItem(fav, i18n("Desktop"), QStringLiteral("desktop"), loc(QStandardPaths::DesktopLocation));
+    addItem(fav, i18n("Downloads"), QStringLiteral("downloads"), loc(QStandardPaths::DownloadLocation));
+    addItem(fav, i18n("Recent Places"), QStringLiteral("recentplaces"), QUrl(QStringLiteral("recentlyused:/locations/")));
+    addSpacer();
+    auto *lib = addItem(nullptr, i18n("Libraries"), QStringLiteral("libraries"), home);
+    addItem(lib, i18n("Documents"), QStringLiteral("documents"), loc(QStandardPaths::DocumentsLocation));
+    addItem(lib, i18n("Music"), QStringLiteral("music"), loc(QStandardPaths::MusicLocation));
+    addItem(lib, i18n("Pictures"), QStringLiteral("pictures"), loc(QStandardPaths::PicturesLocation));
+    addItem(lib, i18n("Videos"), QStringLiteral("videos"), loc(QStandardPaths::MoviesLocation));
+    addSpacer();
+    addItem(nullptr, i18n("Homegroup"), QStringLiteral("homegroup"), QUrl(QStringLiteral("remote:/")));
+    addSpacer();
+    auto *comp = addItem(nullptr, i18n("Computer"), QStringLiteral("computer"), QUrl(QStringLiteral("file:///")));
+    addItem(comp, i18n("Local Disk (C:)"), QStringLiteral("localdisk"), QUrl(QStringLiteral("file:///")));
+    // other drives from dolphin's places model (devices / removable devices)
+    auto *model = DolphinPlacesModelSingleton::instance().placesModel();
+    for (int row = 0; row < model->rowCount(); ++row) {
+        const QModelIndex i = model->index(row, 0);
+        const auto g = model->groupType(i);
+        if (g != KFilePlacesModel::DevicesType && g != KFilePlacesModel::RemovableDevicesType) continue;
+        const QUrl u = model->url(i);
+        if (u.isLocalFile() && u.toLocalFile() == QLatin1String("/")) continue;
+        addItem(comp, model->text(i), g == KFilePlacesModel::RemovableDevicesType ? QStringLiteral("removable") : QStringLiteral("drive"), u, model->icon(i));
+    }
+    addSpacer();
+    addItem(nullptr, i18n("Network"), QStringLiteral("network"), QUrl(QStringLiteral("remote:/")));
+    // explorer's defaults: favorites and libraries open, computer closed (remembered while dolphin runs)
+    for (int i = 0; i < topLevelItemCount(); ++i) {
+        QTreeWidgetItem *t = topLevelItem(i);
+        QSignalBlocker block(this);
+        t->setExpanded(!m_closed.contains(t->text(0)));
+    }
+    setCurrentItem(nullptr);
+    clearSelection();
+    if (current.isValid()) setUrl(current);
+}
+
+void E7NavPane::setUrl(const QUrl &url)
+{
+    QTreeWidgetItem *best = nullptr;
+    int bestLen = -1;
+    for (QTreeWidgetItemIterator it(this); *it; ++it) {
+        const QUrl u = (*it)->data(0, UrlRole).toUrl();
+        if (!u.isValid() || (*it)->parent() == nullptr) continue; // top-level items are not path targets
+        const QString a = u.adjusted(QUrl::StripTrailingSlash).toString(), b = url.adjusted(QUrl::StripTrailingSlash).toString();
+        if ((b == a || b.startsWith(a + QLatin1Char('/'))) && a.length() > bestLen) { best = *it; bestLen = a.length(); }
+    }
+    if (best && best != currentItem()) {
+        QSignalBlocker block(this);
+        setCurrentItem(best);
+    } else if (!best) {
+        QSignalBlocker block(this);
+        setCurrentItem(nullptr);
+        clearSelection();
+    }
+    viewport()->update();
+}
+
+QRect E7NavPane::glyphRect(QTreeWidgetItem *item) const
+{
+    const QRect r = visualItemRect(item);
+    const int d = depthOf(indexFromItem(item));
+    return QRect(r.left() + glyphX(d), r.top(), 16, r.height());
+}
+
+void E7NavPane::mousePressEvent(QMouseEvent *event)
+{
+    QTreeWidgetItem *item = itemAt(event->pos());
+    if (item && item->childCount() > 0 && glyphRect(item).contains(event->pos())) {
+        item->setExpanded(!item->isExpanded());
+        return;
+    }
+    QTreeWidget::mousePressEvent(event);
+}
+
+void E7NavPane::enterEvent(QEnterEvent *event)
+{
+    QTreeWidget::enterEvent(event);
+    viewport()->update();
+}
+
+void E7NavPane::leaveEvent(QEvent *event)
+{
+    QTreeWidget::leaveEvent(event);
+    viewport()->update();
+}
