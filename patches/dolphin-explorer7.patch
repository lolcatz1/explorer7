@@ -0,0 +1,100 @@
+#include "e7detailspane.h"
+#include "e7assets.h"
+#include "views/dolphinview.h"
+
+#include <KFormat>
+#include <KLocalizedString>
+#include <QLocale>
+#include <QPainter>
+
+E7DetailsPane::E7DetailsPane(QWidget *parent)
+    : QWidget(parent)
+{
+    setObjectName(QStringLiteral("e7DetailsPane"));
+    setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Fixed);
+}
+
+QSize E7DetailsPane::sizeHint() const { return {400, 53}; }      // shellstyle: PreviewPaneSizer InitialSize 53
+QSize E7DetailsPane::minimumSizeHint() const { return {100, 53}; }
+
+void E7DetailsPane::setView(DolphinView *view)
+{
+    if (m_view) disconnect(m_view, nullptr, this, nullptr);
+    m_view = view;
+    if (view) {
+        connect(view, &DolphinView::selectionChanged, this, &E7DetailsPane::refresh);
+        connect(view, &DolphinView::itemCountChanged, this, &E7DetailsPane::refresh);
+        connect(view, &DolphinView::directoryLoadingCompleted, this, &E7DetailsPane::refresh);
+        connect(view, &DolphinView::urlChanged, this, &E7DetailsPane::refresh);
+    }
+    refresh();
+}
+
+void E7DetailsPane::refresh()
+{
+    m_props.clear();
+    m_subtitle.clear();
+    if (!m_view) { update(); return; }
+    const KFileItemList sel = m_view->selectedItems();
+    const QLocale loc;
+    if (sel.isEmpty()) {
+        const KFileItem root = m_view->rootItem();
+        m_icon = QIcon::fromTheme(root.isNull() ? QStringLiteral("folder") : root.iconName());
+        m_title = i18np("%1 item", "%1 items", m_view->itemsCount());
+    } else if (sel.count() == 1) {
+        const KFileItem &it = sel.first();
+        m_icon = QIcon::fromTheme(it.iconName());
+        m_title = it.text();
+        m_subtitle = it.isDir() ? i18n("File folder") : it.mimeComment();
+        m_props.append({i18n("Date modified:"), loc.toString(it.time(KFileItem::ModificationTime), QStringLiteral("M/d/yyyy h:mm AP"))});
+        if (!it.isDir()) m_props.append({i18n("Size:"), KFormat().formatByteSize(it.size())});
+        const QDateTime created = it.time(KFileItem::CreationTime);
+        if (created.isValid()) m_props.append({i18n("Date created:"), loc.toString(created, QStringLiteral("M/d/yyyy h:mm AP"))});
+    } else {
+        m_icon = QIcon::fromTheme(QStringLiteral("document-multiple"));
+        m_title = i18np("%1 item selected", "%1 items selected", sel.count());
+        KIO::filesize_t total = 0;
+        for (const KFileItem &it : sel) if (!it.isDir()) total += it.size();
+        if (total) m_props.append({i18n("Size:"), KFormat().formatByteSize(total)});
+    }
+    update();
+}
+
+void E7DetailsPane::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    // background: PreviewPane PREVIEWBACKGROUND (normal), 5px top edge then flat
+    const QPixmap bg = E7::pixmap(QStringLiteral("details-bg"));
+    if (!bg.isNull()) E7::drawFrame(&p, rect(), QStringLiteral("details-bg"), 0, 0, 5, 0);
+    else p.fillRect(rect(), QColor(0xf1, 0xf5, 0xfb));
+    const int iconSize = 40, x0 = 13;
+    m_icon.paint(&p, QRect(x0, (height() - iconSize) / 2, iconSize, iconSize));
+    QFont f = font();
+    const QFontMetrics fm(f);
+    const int tx = x0 + iconSize + 12, lh = fm.height();
+    // title (PreviewPane TITLE #000000), subtitle as a label colour line under it
+    p.setPen(Qt::black);
+    QFont tf = f; tf.setPointSizeF(f.pointSizeF() * 1.25);
+    p.setFont(tf);
+    const QFontMetrics tfm(tf);
+    const int ty = m_subtitle.isEmpty() && m_props.isEmpty() ? (height() - tfm.height()) / 2 : 6;
+    p.drawText(QRect(tx, ty, 260, tfm.height()), Qt::AlignLeft | Qt::AlignVCenter, tfm.elidedText(m_title, Qt::ElideRight, 260));
+    p.setFont(f);
+    if (!m_subtitle.isEmpty()) {
+        p.setPen(QColor(0x5a, 0x67, 0x79)); // PreviewPane LABEL
+        p.drawText(QRect(tx, ty + tfm.height(), 260, lh), Qt::AlignLeft | Qt::AlignVCenter, fm.elidedText(m_subtitle, Qt::ElideRight, 260));
+    }
+    // property columns: label (LABEL #5a6779, right aligned) + value (VALUE #1e395b)
+    int col = tx + 280, row = 0;
+    const int rowsPerCol = qMax(1, (height() - 8) / lh);
+    for (const auto &kv : std::as_const(m_props)) {
+        const int y = 4 + row * lh;
+        const int lw = fm.horizontalAdvance(kv.first);
+        p.setPen(QColor(0x5a, 0x67, 0x79));
+        p.drawText(QRect(col, y, 100, lh), Qt::AlignRight | Qt::AlignVCenter, kv.first);
+        p.setPen(QColor(0x1e, 0x39, 0x5b));
+        p.drawText(QRect(col + 106, y, 180, lh), Qt::AlignLeft | Qt::AlignVCenter, kv.second);
+        Q_UNUSED(lw)
+        if (++row >= rowsPerCol) { row = 0; col += 300; }
+    }
+}
