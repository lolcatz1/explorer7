diff --git a/src/explorer7/e7navbar.cpp b/src/explorer7/e7navbar.cpp
new file mode 100644
index 0000000..41b695d
--- /dev/null
+++ b/src/explorer7/e7navbar.cpp
@@ -0,0 +1,197 @@
+#include "e7navbar.h"
+#include "e7assets.h"
+
+#include <KLocalizedString>
+#include <KToolBarPopupAction>
+#include <QAction>
+#include <QMenu>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QWindow>
+
+namespace
+{
+// the 120 dpi bitmaps (ExplorerFrame 589 band, 585-588 orbs) on scaled screens, 96 dpi (280, 577-581) otherwise
+bool hiDpi(const QWidget *w) { return w->devicePixelRatioF() >= 1.2; }
+QPixmap scaled(const QWidget *w, const QString &base)
+{
+    const bool hi = hiDpi(w);
+    QPixmap pm = E7::pixmap(base + (hi ? QStringLiteral("-120") : QStringLiteral("-96")));
+    if (pm.isNull()) pm = E7::pixmap(base);
+    pm.setDevicePixelRatio(hi ? 1.25 : 1.0);
+    return pm;
+}
+}
+
+E7TravelBand::E7TravelBand(QAction *back, QAction *forward, QWidget *parent)
+    : QWidget(parent)
+    , m_back(back)
+    , m_forward(forward)
+{
+    setObjectName(QStringLiteral("e7TravelBand"));
+    setMouseTracking(true);
+    setAttribute(Qt::WA_TranslucentBackground);
+    setFixedSize(sizeHint());
+    for (QAction *a : {back, forward}) {
+        if (a) connect(a, &QAction::changed, this, qOverload<>(&QWidget::update));
+    }
+}
+
+E7TravelBand::Part E7TravelBand::partAt(const QPoint &p) const
+{
+    if (p.x() < 29) return Back;
+    if (p.x() < 54) return Forward;
+    if (p.x() < 77) return Recent;
+    return None;
+}
+
+void E7TravelBand::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    const bool backOn = m_back && m_back->isEnabled(), fwdOn = m_forward && m_forward->isEnabled();
+    // band: frame 0 without history, 1 with; its own arrow is cut off, explorer draws the drop-down from the theme
+    const bool any = backOn || fwdOn;
+    const QPixmap band = scaled(this, QStringLiteral("band"));
+    const qreal dpr = band.devicePixelRatio(), fw = band.width() / dpr / 4.0;
+    // the band starts 2px right of the back orb (its rounded end hides behind it), ends before its arrow at x 59
+    const qreal keep = 57;
+    p.drawPixmap(QRectF(2, 0, keep, band.height() / dpr), band, QRectF((any ? 1 : 0) * band.width() / 4.0, 0, keep * dpr, band.height()));
+    Q_UNUSED(fw);
+    // recent pages drop-down: aero.msstyles Navigation MENUBUTTON widened to 22px at x 54 (normal, hot glow, pressed, disabled)
+    int mf = 4;
+    if (any) mf = m_pressed == Recent ? 3 : m_hot == Recent ? 2 : 1;
+    const QPixmap menu = scaled(this, QStringLiteral("nav-menu-%1").arg(mf));
+    p.drawPixmap(QRectF(54, 2, 22, menu.height() / menu.devicePixelRatio()), menu, menu.rect());
+    // orbs: aero.msstyles Navigation BACKBUTTON / FORWARDBUTTON (30px, 38px at 120 dpi; frames normal, hot, pressed, disabled),
+    // forward at x 29 so the two overlap by 1px, back painted last on top, as in explorer
+    auto orb = [&](Part part, bool on) {
+        int st = 4;
+        if (on) st = m_pressed == part ? 3 : m_hot == part ? 2 : 1;
+        const QPixmap pm = scaled(this, QStringLiteral("%1-%2").arg(part == Back ? QStringLiteral("nav-back") : QStringLiteral("nav-fwd")).arg(st));
+        p.drawPixmap(QRectF(part == Back ? 0 : 29, 0, 30, 30), pm, pm.rect());
+    };
+    orb(Forward, fwdOn);
+    orb(Back, backOn);
+}
+
+void E7TravelBand::mouseMoveEvent(QMouseEvent *e)
+{
+    const Part h = partAt(e->pos());
+    if (h != m_hot) { m_hot = h; update(); }
+}
+
+void E7TravelBand::leaveEvent(QEvent *)
+{
+    m_hot = None;
+    update();
+}
+
+void E7TravelBand::mousePressEvent(QMouseEvent *e)
+{
+    if (e->button() != Qt::LeftButton) return;
+    m_pressed = partAt(e->pos());
+    update();
+    if (m_pressed == Recent) {
+        // recent pages: dolphin's back history menu (filled on aboutToShow)
+        if (auto *pa = qobject_cast<KToolBarPopupAction *>(m_back.data())) {
+            pa->popupMenu()->exec(mapToGlobal(QPoint(54, height())));
+        }
+        m_pressed = None;
+        update();
+    }
+}
+
+void E7TravelBand::mouseReleaseEvent(QMouseEvent *e)
+{
+    const Part p = partAt(e->pos());
+    if (p == m_pressed) {
+        if (p == Back && m_back && m_back->isEnabled()) m_back->trigger();
+        if (p == Forward && m_forward && m_forward->isEnabled()) m_forward->trigger();
+    }
+    m_pressed = None;
+    update();
+}
+
+// search box ----------------------------------------------------------------
+E7SearchBox::E7SearchBox(QWidget *parent)
+    : QLineEdit(parent)
+{
+    setObjectName(QStringLiteral("e7SearchBox"));
+    setFrame(false);
+    setAttribute(Qt::WA_Hover);
+    setMouseTracking(true);
+    setTextMargins(4, 0, 22, 0);
+    setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Fixed);
+    setFixedSize(sizeHint());
+    QPalette pal = palette();
+    pal.setColor(QPalette::Base, Qt::transparent);
+    pal.setColor(QPalette::PlaceholderText, QColor(0x6d, 0x6d, 0x6d));
+    setPalette(pal);
+}
+
+QSize E7SearchBox::sizeHint() const { return {220, 23}; }   // SearchBox background is 23px tall
+
+void E7SearchBox::setPrompt(const QString &prompt) { setPlaceholderText(prompt); }
+
+QRect E7SearchBox::buttonRect() const { return QRect(width() - 22, 0, 22, height()); }
+
+void E7SearchBox::paintEvent(QPaintEvent *e)
+{
+    {
+        QPainter p(this);
+        // SearchBox background frames: 1 normal, 2 hot, 3 disabled, 4 focused (margins 3,5,5,5)
+        const int f = !isEnabled() ? 3 : hasFocus() ? 4 : m_hover ? 2 : 1;
+        E7::drawFrame(&p, rect(), QStringLiteral("sb-%1").arg(f), 3, 5, 5, 5);
+        // magnifier (34561) while empty, clear cross (34570 / hot 34571) while there is text
+        const QString g = text().isEmpty() ? QStringLiteral("sb-find") : (m_buttonHot ? QStringLiteral("sb-clear-hot") : QStringLiteral("sb-clear"));
+        const QPixmap gp = E7::pixmap(g);
+        const QRect br = buttonRect();
+        p.drawPixmap(br.left() + (br.width() - gp.width()) / 2, (height() - gp.height()) / 2, gp);
+    }
+    if (text().isEmpty() && !placeholderText().isEmpty()) {
+        // windows 7 draws the prompt in italic grey
+        QPainter p(this);
+        QFont f = font(); f.setItalic(true);
+        p.setFont(f);
+        p.setPen(QColor(0x6d, 0x6d, 0x6d));
+        p.drawText(rect().adjusted(6, 0, -24, 0), Qt::AlignVCenter | Qt::AlignLeft, fontMetrics().elidedText(placeholderText(), Qt::ElideRight, width() - 30));
+        const QString keep = placeholderText();
+        QSignalBlocker b(this);
+        setPlaceholderText(QString());
+        QLineEdit::paintEvent(e);
+        setPlaceholderText(keep);
+        return;
+    }
+    QLineEdit::paintEvent(e);
+}
+
+void E7SearchBox::mousePressEvent(QMouseEvent *e)
+{
+    if (buttonRect().contains(e->pos()) && !text().isEmpty()) {
+        clear();
+        Q_EMIT textEdited(QString());
+        return;
+    }
+    QLineEdit::mousePressEvent(e);
+}
+
+void E7SearchBox::mouseMoveEvent(QMouseEvent *e)
+{
+    const bool hot = buttonRect().contains(e->pos());
+    if (hot != m_buttonHot) { m_buttonHot = hot; update(); }
+    setCursor(hot && !text().isEmpty() ? Qt::ArrowCursor : Qt::IBeamCursor);
+    QLineEdit::mouseMoveEvent(e);
+}
+
+void E7SearchBox::enterEvent(QEnterEvent *e) { m_hover = true; update(); QLineEdit::enterEvent(e); }
+void E7SearchBox::leaveEvent(QEvent *e) { m_hover = false; m_buttonHot = false; update(); QLineEdit::leaveEvent(e); }
+
+void E7SearchBox::keyPressEvent(QKeyEvent *e)
+{
+    if (e->key() == Qt::Key_Escape && !text().isEmpty()) {
+        clear();
+        Q_EMIT textEdited(QString());
+        return;
+    }
+    QLineEdit::keyPressEvent(e);
+}
