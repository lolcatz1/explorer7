diff --git a/src/explorer7/e7breadcrumb.cpp b/src/explorer7/e7breadcrumb.cpp
new file mode 100644
index 0000000..63938b8
--- /dev/null
+++ b/src/explorer7/e7breadcrumb.cpp
@@ -0,0 +1,149 @@
+#include "e7breadcrumb.h"
+#include "e7assets.h"
+
+#include <KUrlNavigator>
+#include <QTimer>
+#include <QUrl>
+#include <QAbstractButton>
+#include <QFontMetrics>
+#include <QChildEvent>
+#include <QEvent>
+#include <QPainter>
+#include <QPainterPath>
+
+namespace
+{
+bool isCrumb(const QObject *o) { return qstrcmp(o->metaObject()->className(), "KDEPrivate::KUrlNavigatorButton") == 0; }
+bool isPlaces(const QObject *o) { return qstrcmp(o->metaObject()->className(), "KDEPrivate::KUrlNavigatorPlacesSelector") == 0; }
+bool isDropDown(const QObject *o) { return qstrcmp(o->metaObject()->className(), "KDEPrivate::KUrlNavigatorDropDownButton") == 0; }
+bool isToggle(const QObject *o) { return qstrcmp(o->metaObject()->className(), "KDEPrivate::KUrlNavigatorToggleButton") == 0; }
+// explorer's breadcrumb separator: small black triangle pointing right
+void drawArrow(QPainter &p, int cx, int cy)
+{
+    p.save();
+    p.setRenderHint(QPainter::Antialiasing, false);
+    p.setPen(Qt::NoPen);
+    p.setBrush(Qt::black);
+    QPainterPath tri;
+    tri.moveTo(cx - 1, cy - 4); tri.lineTo(cx - 1, cy + 4); tri.lineTo(cx + 3, cy);
+    tri.closeSubpath();
+    p.drawPath(tri);
+    p.restore();
+}
+}
+
+E7Breadcrumb::E7Breadcrumb(KUrlNavigator *nav)
+    : QObject(nav)
+    , m_nav(nav)
+{
+    nav->installEventFilter(this);
+    nav->setFixedHeight(17); // inside the 23px AB::AddressBand box, like explorer
+    const auto kids = nav->findChildren<QObject *>();
+    for (QObject *c : kids) hook(c);
+    connect(nav, &KUrlNavigator::urlChanged, this, [this]() { QTimer::singleShot(0, this, &E7Breadcrumb::relayout); });
+    QTimer::singleShot(0, this, &E7Breadcrumb::relayout);
+}
+
+void E7Breadcrumb::relayout()
+{
+    // icon + ▸ when the whole path fits; icon + « when leading folders are hidden
+    QWidget *places = nullptr;
+    bool overflow = false;
+    for (QWidget *w : m_nav->findChildren<QWidget *>()) {
+        if (isPlaces(w)) places = w;
+        if (isDropDown(w) && w->isVisible()) overflow = true;
+    }
+    if (places) places->setFixedWidth(overflow ? 22 : 30);
+    // the last folder gets room for "name ▸" in regular weight (kio sized it for bold text without an arrow)
+    for (QAbstractButton *b : m_nav->findChildren<QAbstractButton *>()) {
+        if (!isCrumb(b)) continue;
+        const QString text = b->text().remove(QLatin1Char('&'));
+        QFont bold = b->font(); bold.setBold(true);
+        const bool last = b->sizeHint().width() == 5 + QFontMetrics(bold).size(Qt::TextSingleLine, text).width() + 5;
+        b->setMinimumWidth(last ? 5 + b->fontMetrics().horizontalAdvance(text) + 13 : 0);
+    }
+}
+
+void E7Breadcrumb::hook(QObject *child)
+{
+    if (child->property("e7hooked").toBool() || !(isCrumb(child) || isPlaces(child) || isDropDown(child) || isToggle(child))) return;
+    child->setProperty("e7hooked", true);
+    child->installEventFilter(this);
+    if (auto *w = qobject_cast<QWidget *>(child)) {
+        w->setAttribute(Qt::WA_Hover);
+        w->setMouseTracking(true);
+    }
+}
+
+bool E7Breadcrumb::eventFilter(QObject *watched, QEvent *event)
+{
+    if (event->type() == QEvent::ChildAdded || event->type() == QEvent::ChildPolished) {
+        hook(static_cast<QChildEvent *>(event)->child());
+        return false;
+    }
+    if (event->type() == QEvent::HoverMove || event->type() == QEvent::HoverEnter || event->type() == QEvent::HoverLeave) {
+        if (auto *w = qobject_cast<QWidget *>(watched)) w->update();
+        return false;
+    }
+    if (event->type() != QEvent::Paint) return false;
+    auto *b = qobject_cast<QAbstractButton *>(watched);
+    if (!b) return false;
+    QPainter p(b);
+    const int h = b->height();
+    if (isPlaces(b)) {
+        // explorer: the location's icon (magnifier on search results), then ▸
+        const bool search = m_nav->locationUrl().scheme().contains(QLatin1String("search"));
+        const QIcon ic = search ? QIcon(E7::pixmap(QStringLiteral("addr-search"))) : b->icon();
+        ic.paint(&p, QRect(3, (h - 16) / 2, 16, 16));
+        bool overflow = false;
+        for (QWidget *w : m_nav->findChildren<QWidget *>()) overflow |= isDropDown(w) && w->isVisible();
+        if (!overflow) drawArrow(p, 25, h / 2);
+        return true;
+    }
+    if (isDropDown(b)) {
+        // hidden leading folders: BreadcrumbBar overflow chevron «
+        const QPixmap g = E7::pixmap(b->underMouse() ? QStringLiteral("crumb-overflow-2") : QStringLiteral("crumb-overflow-1"));
+        p.drawPixmap((b->width() - g.width()) / 2, (h - g.height()) / 2, g);
+        return true;
+    }
+    if (isToggle(b)) {
+        // the empty part of the box: draws the trailing ▸ when the last crumb had no room for it
+        return true;
+    }
+    // kio sizes the current folder's button as padding + bold text + padding (no arrow); the others carry an arrow area (height/2)
+    const QString text = b->text().remove(QLatin1Char('&'));
+    const QFontMetrics fm(b->font());
+    QFont bold = b->font(); bold.setBold(true);
+    const int pad = 5, arrowW = qMax(4, h / 2);
+    const bool hasArrow = b->sizeHint().width() != pad + QFontMetrics(bold).size(Qt::TextSingleLine, text).width() + pad;
+    const QPoint m = b->mapFromGlobal(QCursor::pos());
+    const bool hot = b->underMouse() || b->isDown();
+    const int split = b->width() - (hasArrow ? arrowW + 2 : 0);
+    if (hot) {
+        // CommandModule split button hot frames: text part + arrow part (pressed frames while held)
+        const bool overArrow = hasArrow && m.x() >= split;
+        const int fl = b->isDown() && !overArrow ? 3 : 2, fr = b->isDown() && overArrow ? 3 : 2;
+        E7::drawFrame(&p, QRect(0, 0, hasArrow ? split : b->width(), h), QStringLiteral("cm-split-left-%1").arg(fl), 3, 2, 6, 6);
+        if (hasArrow) E7::drawFrame(&p, QRect(split, 0, b->width() - split, h), QStringLiteral("cm-split-right-%1").arg(fr), 1, 3, 6, 6);
+    }
+    p.setPen(Qt::black);
+    p.setFont(b->font());
+    p.drawText(QRect(pad, 0, split - pad, h), Qt::AlignVCenter | Qt::AlignLeft, fm.elidedText(text, Qt::ElideRight, split - pad - 1));
+    if (!hasArrow) {
+        // explorer ends the path with ▸ 7px after the last folder name; if the button is too narrow the empty area after it draws it
+        drawArrow(p, qMin(b->width() - 5, pad + fm.horizontalAdvance(text) + 7), h / 2);
+    }
+    if (hasArrow) {
+        // small black triangle pointing right (down while its menu is open)
+        p.setRenderHint(QPainter::Antialiasing, false);
+        p.setPen(Qt::NoPen);
+        p.setBrush(Qt::black);
+        const int cx = split + (b->width() - split) / 2, cy = h / 2;
+        QPainterPath tri;
+        if (b->isDown()) { tri.moveTo(cx - 3, cy - 1); tri.lineTo(cx + 4, cy - 1); tri.lineTo(cx, cy + 3); }
+        else { tri.moveTo(cx - 1, cy - 4); tri.lineTo(cx - 1, cy + 4); tri.lineTo(cx + 3, cy); }
+        tri.closeSubpath();
+        p.drawPath(tri);
+    }
+    return true;
+}
