diff --git a/src/explorer7/e7assets.cpp b/src/explorer7/e7assets.cpp
new file mode 100644
index 0000000..f71e512
--- /dev/null
+++ b/src/explorer7/e7assets.cpp
@@ -0,0 +1,64 @@
+#include "e7assets.h"
+#include <QDir>
+#include <QHash>
+#include <QPainter>
+#include <QStandardPaths>
+
+namespace E7
+{
+QString imgDir()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/explorer7/img/");
+}
+
+QPixmap pixmap(const QString &name)
+{
+    static QHash<QString, QPixmap> cache;
+    auto it = cache.find(name);
+    if (it != cache.end()) {
+        return *it;
+    }
+    QPixmap pm(imgDir() + name + QStringLiteral(".png"));
+    cache.insert(name, pm);
+    return pm;
+}
+
+QIcon icon(const QString &name)
+{
+    static QHash<QString, QIcon> cache;
+    auto it = cache.find(name);
+    if (it != cache.end()) {
+        return *it;
+    }
+    QIcon ic;
+    const QDir d(imgDir() + QStringLiteral("icons"));
+    const auto files = d.entryList({name + QStringLiteral("-*.png")}, QDir::Files);
+    for (const QString &f : files) {
+        ic.addFile(d.filePath(f));
+    }
+    cache.insert(name, ic);
+    return ic;
+}
+
+void drawFrame(QPainter *p, const QRect &r, const QString &name, int l, int rgt, int t, int b)
+{
+    const QPixmap pm = pixmap(name);
+    if (pm.isNull() || r.isEmpty()) {
+        return;
+    }
+    const int W = pm.width(), H = pm.height();
+    const int xs[4] = {0, l, W - rgt, W}, ys[4] = {0, t, H - b, H};
+    const int dx[4] = {r.left(), r.left() + l, r.right() + 1 - rgt, r.right() + 1};
+    const int dy[4] = {r.top(), r.top() + t, r.bottom() + 1 - b, r.bottom() + 1};
+    for (int j = 0; j < 3; ++j) {
+        for (int i = 0; i < 3; ++i) {
+            const QRect src(xs[i], ys[j], xs[i + 1] - xs[i], ys[j + 1] - ys[j]);
+            const QRect dst(dx[i], dy[j], dx[i + 1] - dx[i], dy[j + 1] - dy[j]);
+            if (src.isEmpty() || dst.isEmpty()) {
+                continue;
+            }
+            p->drawPixmap(dst, pm, src);
+        }
+    }
+}
+}
